PROJECT_NAME=task-manager-api
ENVIRONMENT=local
DEBUG=true

# --- Database credentials -------------------------------------------------
# Three separate roles, least privilege per process (generate each with
# `openssl rand -base64 24`, three DIFFERENT values — never reuse one):
#
#   postgres (superuser)  - bootstraps the cluster only; the app never uses it
#   POSTGRES_MIGRATOR_*   - DDL rights (CREATE/ALTER/DROP TABLE); used only by
#                           the one-shot `migrate` compose service running
#                           `alembic upgrade head`
#   POSTGRES_USER/PASSWORD - DML only (SELECT/INSERT/UPDATE/DELETE), no DDL;
#                           used by the always-running `api` service
#
# See db/init/001_create_roles.sh for how these are provisioned.
POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_A_GENERATED_SECRET

POSTGRES_MIGRATOR_USER=migrator
POSTGRES_MIGRATOR_PASSWORD=REPLACE_WITH_A_DIFFERENT_GENERATED_SECRET

POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_YET_ANOTHER_GENERATED_SECRET

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=task_manager
DATABASE_ECHO=false

# --- Auth ------------------------------------------------------------------
# High-entropy signing key, minimum 32 characters. Generate with:
#   openssl rand -hex 32
# Rotate via a secrets manager (Vault/AWS Secrets Manager/Azure Key Vault) in
# any non-local environment; never commit a real value here.
JWT_SECRET_KEY=REPLACE_WITH_A_GENERATED_32_BYTE_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis (access-token revocation list + refresh-token allowlist) --------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=REPLACE_WITH_A_GENERATED_SECRET

# --- HTTP / CORS -------------------------------------------------------------
# Explicit allowlist only — the app rejects "*" at startup.
CORS_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

LOG_LEVEL=INFO
